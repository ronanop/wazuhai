# Paste into Coolify → Environment Variables (Developer view).
# Replace every change_me / UUID before Deploy.

# --- Aegis ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_strong_pg_password
POSTGRES_DB=aegis
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true
# Leave empty to use Coolify-generated SERVICE_URL_FRONTEND_80
CORS_ORIGIN=

WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Internal Docker DNS (same Compose network) — do not use host.docker.internal on Coolify
OPENCTI_URL=http://opencti:8080
# Usually same as OPENCTI_ADMIN_TOKEN
OPENCTI_TOKEN=
OPENCTI_STREAM_ID=
# Leave empty to use Coolify-generated SERVICE_URL_OPENCTI_8080
OPENCTI_UI_URL=
OPENCTI_EXTERNAL_URL=

# --- OpenCTI ---
MINIO_ROOT_USER=openctiMinio
MINIO_ROOT_PASSWORD=change_me_minio_password
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password
SMTP_HOSTNAME=localhost
ELASTIC_MEMORY_SIZE=2G

OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=change_me_opencti_admin_password
OPENCTI_ADMIN_TOKEN=00000000-0000-0000-0000-000000000000
OPENCTI_HEALTHCHECK_ACCESS_KEY=change_me_healthcheck_key

CONNECTOR_EXPORT_FILE_STIX_ID=00000000-0000-0000-0000-000000000001
CONNECTOR_EXPORT_FILE_CSV_ID=00000000-0000-0000-0000-000000000002
CONNECTOR_IMPORT_FILE_STIX_ID=00000000-0000-0000-0000-000000000003
CONNECTOR_OPENCTI_ID=00000000-0000-0000-0000-000000000004
CONNECTOR_MITRE_ID=00000000-0000-0000-0000-000000000005
