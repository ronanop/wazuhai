POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aegis
DATABASE_URL=postgresql://aegis:change_me@postgres:5432/aegis?schema=public

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Local HTTP: false | Coolify HTTPS: true
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

WAZUH_API_URL=https://192.168.191.128:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_INDEXER_URL=https://192.168.191.128:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenCTI companion (see opencti/README.md)
# Local (two Compose projects): http://host.docker.internal:8080
# Coolify (same stack):         http://opencti:8080
OPENCTI_URL=http://host.docker.internal:8080
OPENCTI_TOKEN=
OPENCTI_STREAM_ID=
OPENCTI_UI_URL=http://localhost:8080

